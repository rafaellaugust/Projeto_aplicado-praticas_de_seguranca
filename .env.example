# ============================================
# Variáveis de Ambiente — MikroTik Pay
# Copie este arquivo para .env e preencha os valores reais
# NUNCA faça commit do arquivo .env!
# ============================================

# ---- Banco de Dados ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spaconet_aplicacao
DB_USER=root
DB_PASS=

# ---- Aplicação ----
APP_URL=https://seu-ip-ou-dominio
APP_ENV=production

# ---- Segurança & Autenticação ----
# Chave de criptografia para secrets TOTP (gerada com 32 bytes hex)
TOTP_ENCRYPTION_KEY=

# Google reCAPTCHA v2 (opcional - se vazio, a verificação é ignorada)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Token de autorização para chamadas de rotinas Cron web
CRON_TOKEN=

# Configurações de E-mail para 2FA por E-mail
MAIL_FROM=no-reply@spaconett.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# ---- MikroTik (opcional) ----
MK_HOST=
MK_USER=
MK_PASS=
MK_PORT=8728

# ---- Gateway de Pagamento (opcional) ----
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ---- Telegram (opcional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- WhatsApp API (opcional) ----
WA_API_URL=http://localhost:21465
WA_SESSION=default
WA_TOKEN=
