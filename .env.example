# ============================================
# Variáveis de Ambiente — MikroTik Pay
# Copie este arquivo para .env e preencha os valores reais
# NUNCA faça commit do arquivo .env!
# ============================================

# ---- Banco de Dados ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spaconet_aplicacao
DB_USER=root
DB_PASS=

# ---- Aplicação ----
APP_URL=https://seu-ip-ou-dominio
APP_ENV=production

# ---- Segurança ----
# Chave de criptografia para secrets TOTP (gere com: php -r "echo bin2hex(random_bytes(32));")
TOTP_ENCRYPTION_KEY=

# ---- MikroTik (opcional) ----
MK_HOST=
MK_USER=
MK_PASS=
MK_PORT=8728

# ---- Gateway de Pagamento (opcional) ----
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ---- Telegram (opcional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- WhatsApp API (opcional) ----
WA_API_URL=http://localhost:21465
WA_SESSION=default
WA_TOKEN=
